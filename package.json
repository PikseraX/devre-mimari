{
  "name": "devre-mimari",
  "version": "1.0.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "postinstall": "node scripts/build-game.cjs",
    "prepare:game": "node scripts/build-game.cjs",
    "start": "npm run prepare:game && expo start",
    "android": "npm run prepare:game && expo start --android",
    "ios": "npm run prepare:game && expo start --ios",
    "check": "npm run prepare:game && expo install --check",
    "export": "npm run prepare:game && expo export --platform all",
    "build:android:apk": "npx eas-cli@latest build --platform android --profile preview",
    "build:android": "npx eas-cli@latest build --platform android --profile production",
    "build:ios": "npx eas-cli@latest build --platform ios --profile production",
    "build:ios:simulator": "npx eas-cli@latest build --platform ios --profile simulator",
    "test": "npm run prepare:game && node --test tests/ads-policy.cjs tests/mobile.cjs",
    "icons": "node scripts/create-icons.cjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.26",
    "expo-clipboard": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-google-mobile-ads": "^17.4.0",
    "react-native-iap": "^17.4.1",
    "react-native-nitro-modules": "^0.37.2",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@expo/config-plugins": "^58.0.13",
    "@fontsource/inter": "^5.2.0",
    "@fontsource/jetbrains-mono": "^5.2.0",
    "@playwright/test": "^1.65.1",
    "postcss": "^8.5.33",
    "sharp": "^0.35.5",
    "tailwindcss": "3.4.19"
  }
}
